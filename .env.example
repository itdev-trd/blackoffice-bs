# =============================================================
#  ตัวแปรสภาพแวดล้อม
#  คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า (ไฟล์ .env ไม่ขึ้น git)
# =============================================================

# -------------------------------------------------------------
#  ต้องใส่บน Vercel ด้วย (Settings → Environment Variables)
#  ทั้งสองตัวขึ้นต้นด้วย NEXT_PUBLIC_ = ถูกฝังลงไปในหน้าเว็บ
#  จึงต้องเป็น "anon key" เท่านั้น ห้ามใช้ service_role key เด็ดขาด
#  หาได้ที่ Supabase → Project Settings → API
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -------------------------------------------------------------
#  ใช้เฉพาะเครื่องพัฒนา/สคริปต์ — ไม่ต้องใส่บน Vercel
#  ตัวเว็บ (Next.js) ไม่ได้อ่านสองตัวนี้เลย ฝั่งที่ใช้จริงคือ
#  Supabase Edge Functions ซึ่งเก็บ secret ของตัวเองที่
#  Supabase → Edge Functions → Secrets
#  ใส่ไว้ที่ Vercel = เพิ่มที่เก็บความลับโดยไม่จำเป็น
# -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
